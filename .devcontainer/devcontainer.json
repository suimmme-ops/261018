{
  "name": "에듀루트 업무 길잡이",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "customizations": {
    "codespaces": {
      "openFiles": ["eduroute_agent/README.md", "eduroute_agent/app.py"]
    },
    "vscode": {
      "extensions": ["ms-python.python"]
    }
  },
  // 코드스페이스를 처음 만들 때 한 번: 패키지 설치
  "postCreateCommand": "pip install --user -r eduroute_agent/requirements.txt",
  // 코드스페이스에 접속할 때마다: 데모 자동 실행
  "postAttachCommand": {
    "server": "cd eduroute_agent && streamlit run app.py --server.enableCORS false --server.enableXsrfProtection false"
  },
  "portsAttributes": {
    "8501": {
      "label": "Streamlit 데모",
      "onAutoForward": "openPreview"
    }
  },
  "forwardPorts": [8501],
  // Settings > Codespaces > Secrets 에 등록한 키를 이 코드스페이스에 요청
  "secrets": {
    "GEMINI_API_KEY": {
      "description": "Google AI Studio에서 발급한 Gemini API 키"
    }
  }
}
